import tkinter as tk
from tkinter import ttk
from tkinter import messagebox

from controller import SistemaSoftwareFJ


class VentanaPrincipal:

    def __init__(self):

        self.sistema = SistemaSoftwareFJ()

        self.ventana = tk.Tk()
        self.ventana.title("Software FJ")
        self.ventana.geometry("900x650")
        self.ventana.resizable(False, False)

        self.crear_componentes()

        self.ventana.mainloop()
          def crear_componentes(self):

        titulo = tk.Label(
            self.ventana,
            text="SOFTWARE FJ\nSistema de Gestión",
            font=("Arial",18,"bold")
        )

        titulo.pack(pady=15)
        frame = tk.LabelFrame(
            self.ventana,
            text="Registro Cliente"
        )

        frame.pack(fill="x", padx=15, pady=10)
        tk.Label(frame,text="Código").grid(row=0,column=0,padx=5,pady=5)

        self.codigo=tk.Entry(frame,width=20)

        self.codigo.grid(row=0,column=1)
         tk.Label(frame,text="Nombre").grid(row=1,column=0)

        self.nombre=tk.Entry(frame,width=40)

        self.nombre.grid(row=1,column=1)
        tk.Label(frame,text="Documento").grid(row=2,column=0)

        self.documento=tk.Entry(frame,width=30)

        self.documento.grid(row=2,column=1)
         tk.Label(frame,text="Teléfono").grid(row=3,column=0)

        self.telefono=tk.Entry(frame,width=30)

        self.telefono.grid(row=3,column=1)
          boton=tk.Button(

            frame,

            text="Registrar Cliente",

            bg="green",

            fg="white",

            command=self.registrar_cliente

        )

        boton.grid(row=4,column=0,columnspan=2,pady=10)
         self.texto=tk.Text(

            self.ventana,

            width=100,

            height=20

        )

        self.texto.pack(pady=10)
        def registrar_cliente(self):

        try:

            cliente=self.sistema.registrar_cliente(

                int(self.codigo.get()),

                self.nombre.get(),

                self.documento.get(),

                self.telefono.get()

            )

            messagebox.showinfo(

                "Correcto",

                "Cliente registrado correctamente"

            )

            self.actualizar()

        except Exception as error:

            messagebox.showerror(

                "Error",

                str(error)

            )
